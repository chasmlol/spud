# Writes OUT: a C++ source holding every *.txt in DIR as a byte array (the record schema and the condition
# table, compiled into the importer). Run by src/importer/CMakeLists.txt.
file(GLOB files "${DIR}/*.txt")
list(SORT files)
set(body "// Generated from src/importer/schema/*.txt by embed.cmake. Do not edit.\n#include <cstddef>\n\nnamespace spud::records {\n\nstruct EmbeddedFile {\n    const char* name;\n    const unsigned char* data;\n    size_t size;\n};\n\nnamespace {\n")
set(table "")
set(i 0)
foreach(f ${files})
    get_filename_component(name "${f}" NAME)
    file(READ "${f}" hex HEX)
    string(LENGTH "${hex}" n)
    math(EXPR size "${n} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "const unsigned char k_file${i}[] = {${bytes}0};\n")
    string(APPEND table "    {\"${name}\", k_file${i}, ${size}},\n")
    math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "} // namespace\n\nextern const EmbeddedFile k_embedded_schema[] = {\n${table}    {nullptr, nullptr, 0},\n};\n\n} // namespace spud::records\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
